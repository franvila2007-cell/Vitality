# Copy to .env.local for local dev, and set the same keys in Vercel's
# project settings for the deployed app. Never commit the real .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Used for the coach-invite
# flow and the foods_global seed script. Get it from Supabase dashboard >
# Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the /api/vitto/message route as a fallback when the local parser
# can't confidently resolve a food entry.
ANTHROPIC_API_KEY=
